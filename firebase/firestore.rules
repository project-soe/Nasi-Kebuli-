rules_version = '2';

// Tempel isi file ini di: Firebase Console > Firestore Database > Rules > Publish
//
// Ringkasan keamanan:
// - Pelanggan boleh MEMBUAT pesanan, tetapi server (aturan ini) memeriksa SETIAP baris:
//   harga dan nama harus sama dengan menu, jumlah 1-20, dan total harus sama dengan
//   jumlah (harga x jumlah) + ongkos kirim. Ongkir dan metode bayar juga harus sesuai pengaturan toko.
//   Harga dari browser tidak dipercaya.
// - Data pribadi (nama, HP, catatan) hanya ada di "orders" yang hanya bisa dibaca admin.
// - Pelanggan memantau status lewat "orderStatus": salinan publik TANPA data pribadi,
//   dibaca lewat ID acak yang hanya ia ketahui.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- fungsi bantu ----------

    // Admin = akun dengan dokumen admins/{uid}. Dokumen itu hanya bisa dibuat lewat Firebase Console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Pengaturan toko menentukan: toko buka, opsi ambil/antar yang aktif, dan ongkos kirim.
    // Ongkos kirim di pesanan HARUS sama dengan pengaturan (bukan angka dari browser).
    // Bila pengaturan toko belum dibuat: toko dianggap buka, dua opsi aktif, ongkir 0.
    function settingsMatch(d, st) {
      return st.get('isOpen', true) != false
        && (d.fulfillment == 'antar'
              ? st.get('deliveryEnabled', true) != false
              : st.get('pickupEnabled', true) != false)
        && d.deliveryFee == (d.fulfillment == 'antar' ? st.get('deliveryFee', 0) : 0)
        && (d.paymentMethod == 'tunai'
              ? st.get('paymentCash', true) != false
              : d.paymentMethod == 'transfer'
                  ? st.get('paymentTransfer', false) == true
                  : st.get('paymentQris', false) == true);
    }

    function settingsOk(d) {
      return !exists(/databases/$(database)/documents/settings/store)
        ? (d.deliveryFee == 0 && d.paymentMethod == 'tunai')
        : settingsMatch(d, get(/databases/$(database)/documents/settings/store).data);
    }

    // Satu baris pesanan harus cocok dengan dokumen menunya
    function menuMatches(it) {
      let m = get(/databases/$(database)/documents/menu/$(it.id)).data;
      return it.price == m.price
        && it.name == m.name
        && m.get('available', true) != false;
    }

    function lineOk(it) {
      return it is map
        && it.keys().hasOnly(['id', 'name', 'price', 'qty'])
        && it.id is string && it.id.matches('^[A-Za-z0-9_-]{1,40}$')
        && it.name is string
        && it.qty is int && it.qty >= 1 && it.qty <= 20
        && it.price is int && it.price > 0
        && menuMatches(it);
    }

    // Aturan tidak punya perulangan, jadi tiap baris (maks. 6) diperiksa satu per satu.
    // Batas 6 menjaga jumlah pembacaan dokumen di bawah batas 10 per permintaan.
    function lineAt(d, i) {
      return d.items.size() <= i || lineOk(d.items[i]);
    }

    function lineTotal(d, i) {
      return d.items.size() <= i ? 0 : d.items[i].price * d.items[i].qty;
    }

    function validOrder(d) {
      return d.keys().hasOnly(['customerName', 'phone', 'note', 'fulfillment', 'address', 'deliveryFee',
                               'paymentMethod', 'items', 'total', 'status', 'createdAt'])
        && d.keys().hasAll(['customerName', 'phone', 'fulfillment', 'deliveryFee', 'paymentMethod',
                            'items', 'total', 'status', 'createdAt'])
        && d.customerName is string && d.customerName.size() >= 2 && d.customerName.size() <= 60
        && d.phone is string && d.phone.matches('^08[1-9][0-9]{6,11}$')
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && d.fulfillment in ['ambil', 'antar']
        && d.paymentMethod in ['tunai', 'transfer', 'qris']
        && (d.fulfillment == 'antar'
              ? ('address' in d && d.address is string && d.address.size() >= 10 && d.address.size() <= 200)
              : !('address' in d))
        && d.deliveryFee is int && d.deliveryFee >= 0 && d.deliveryFee <= 500000
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 6
        && lineAt(d, 0) && lineAt(d, 1) && lineAt(d, 2)
        && lineAt(d, 3) && lineAt(d, 4) && lineAt(d, 5)
        && d.total is int && d.total > 0 && d.total <= 10000000
        && d.total == lineTotal(d, 0) + lineTotal(d, 1) + lineTotal(d, 2)
                    + lineTotal(d, 3) + lineTotal(d, 4) + lineTotal(d, 5) + d.deliveryFee
        && d.status == 'menunggu'
        && d.createdAt == request.time;
    }

    // Salinan publik: harus identik dengan isi pesanan yang dibuat BERSAMAAN (batch yang sama).
    // Tidak memuat nama, HP, alamat, atau catatan.
    function statusMatchesOrder(d, o) {
      return d.items == o.items
        && d.total == o.total
        && d.fulfillment == o.fulfillment
        && d.deliveryFee == o.deliveryFee
        && d.paymentMethod == o.paymentMethod;
    }

    function validStatusDoc(d, orderId) {
      return d.keys().hasOnly(['items', 'total', 'status', 'createdAt', 'fulfillment', 'deliveryFee', 'paymentMethod'])
        && d.keys().hasAll(['items', 'total', 'status', 'createdAt', 'fulfillment', 'deliveryFee', 'paymentMethod'])
        && d.status == 'menunggu'
        && d.createdAt == request.time
        && statusMatchesOrder(d, getAfter(/databases/$(database)/documents/orders/$(orderId)).data);
    }

    // ---------- koleksi ----------

    // Menu dan pengaturan toko: semua orang boleh membaca, hanya admin yang mengubah
    match /menu/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pesanan LENGKAP (nama, HP, catatan): hanya admin yang bisa membaca/mengubah.
    // Pelanggan hanya bisa membuat, dan wajib dibuat bersama dokumen orderStatus.
    match /orders/{orderId} {
      allow create: if validOrder(request.resource.data)
        && settingsOk(request.resource.data)
        && existsAfter(/databases/$(database)/documents/orderStatus/$(orderId));
      allow get, list, update, delete: if isAdmin();

      match /history/{historyId} {
        allow read, write: if isAdmin();
      }
    }

    // Status pesanan untuk pelanggan: tanpa data pribadi.
    // Admin harus tetap bisa membuat/update dokumen status yang belum lengkap, termasuk merge.
    match /orderStatus/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || validStatusDoc(request.resource.data, orderId);
      allow update: if isAdmin() || validStatusDoc(request.resource.data, orderId);
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Selain itu: tertutup
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
