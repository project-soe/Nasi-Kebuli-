# Salin menjadi backend/.env lalu isi. JANGAN commit file .env
PORT=3000
NODE_ENV=development

# URL web app Google Apps Script (hasil Deploy)
APPS_SCRIPT_URL=
# Kunci rahasia bersama antara backend dan Apps Script
APPS_SCRIPT_SECRET=

# Login admin
ADMIN_PASSWORD=
JWT_SECRET=

# Alamat website yang boleh mengakses API (CORS)
ALLOWED_ORIGIN=http://localhost:3000
